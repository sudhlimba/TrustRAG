# ==============================================================================
# TrustRAG Environment Configuration
# ==============================================================================

# OpenAI API Key for embeddings and answer generation
OPENAI_API_KEY=your-openai-api-key-here

# Database Configuration
# Set to 'sqlite' for zero-setup local dev or 'postgres' for production
DB_TYPE=sqlite
DB_SQLITE_PATH=trust_rag.db

# PostgreSQL credentials (active if DB_TYPE=postgres or DATABASE_URL is set)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/trustrag_db

# ChromaDB Settings
CHROMA_PERSIST_DIR=./chroma_data

# Threat Firewall Settings
THREAT_SIMILARITY_THRESHOLD=0.82
